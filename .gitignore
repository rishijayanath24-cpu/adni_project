# ADNI data is governed by a Data Use Agreement — never commit raw or processed patient data.
data/raw/
data/processed/
*.csv
# ...but aggregate result tables carry no subject-level data and are
# part of the paper, so they are tracked.
!paper/tables/*.csv
*.nii
*.nii.gz

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Local tooling config
.claude/

# Trained model binaries: derived from DUA-governed ADNI data and
# regenerable via src/models/train_final.py. Registry and card are tracked.
models/*.pkl

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
